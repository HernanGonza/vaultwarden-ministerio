/* ───────── Tipografía ───────── */
body,
body input,
body button,
body select,
body textarea {
  font-family: "Oak Sans", "Inter", ui-sans-serif, system-ui, sans-serif;
  -webkit-font-smoothing: antialiased;
}
::selection { background: rgb(245 165 191 / 0.55); }

/* ───────── Forma: botones en píldora, campos y tarjetas redondeados ───────── */
button[bitbutton],
a[bitbutton] {
  border-radius: 999px;
  font-weight: 600;
  transition: transform 0.15s, filter 0.15s, box-shadow 0.15s;
}
button[bitbutton]:not(:disabled):hover,
a[bitbutton]:hover { transform: translateY(-1px); filter: brightness(1.06); }
button[bitbutton]:not(:disabled):active { transform: scale(0.97); }

input[bitinput],
select[bitinput],
textarea[bitinput],
bit-form-field > div { border-radius: 0.75rem; }

bit-base-card,
bit-card,
.tw-rounded-xl { border-radius: 1.25rem; }

/* ───────── Pantalla de login ───────── */
/* Logo del encabezado: flor del lapacho + ECOLOGÍA / MISIONES (reemplaza el de Vaultwarden) */
bit-landing-header header a {
  display: grid !important;
  grid-template-columns: auto auto;
  align-items: center;
  justify-content: start;
  column-gap: 0.7rem;
  width: auto !important;
}
bit-landing-header header a::before {
  content: "";
  grid-row: 1;
  width: 2.5rem;
  height: 2.5rem;
  background: url("../images/ministerio/flor-lapacho.svg") center / contain no-repeat;
  filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.18));
}
bit-landing-header header a bit-svg { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; }
bit-landing-header header a bit-svg svg { display: none; }
bit-landing-header header a bit-svg::before {
  content: "ECOLOGÍA";
  font-size: 1.2rem;
  font-weight: 500;
  letter-spacing: 0.04em;
  line-height: 1;
  color: rgb(var(--color-primary-600));
}
bit-landing-header header a bit-svg::after {
  content: "MISIONES";
  margin-top: 0.22rem;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.32em;
  line-height: 1;
  color: rgb(var(--color-primary-600));
}

/* Ilustración del hero: la caja fuerte se cambia por la flor */
bit-landing-hero bit-svg svg { display: none; }
bit-landing-hero bit-svg::before {
  content: "";
  display: block;
  width: 5rem;
  height: 5rem;
  background: url("../images/ministerio/flor-lapacho.svg") center / contain no-repeat;
  filter: drop-shadow(0 6px 14px rgb(201 52 108 / 0.28));
}

/* Se saca el dibujo decorativo de fondo de Vaultwarden */
auth-anon-layout div[class*="tw-opacity-[.11]"] { display: none; }
