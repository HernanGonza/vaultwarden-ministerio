  --color-background-alt2: 62 108 81;
  --color-background-alt3: 20 31 24;
  --color-background-alt4: 13 22 17;

  --color-primary-100: 27 42 33;
  --color-primary-300: 36 51 41;
  --color-primary-600: 134 185 154;
  --color-primary-700: 170 205 185;

  --color-secondary-100: 27 42 33;
  --color-secondary-300: 46 64 53;
  --color-secondary-500: 150 167 155;
  --color-secondary-600: 170 185 174;
  --color-secondary-700: 190 203 193;

  --color-info-100: 40 48 20;
  --color-info-600: 186 204 120;
  --color-info-700: 235 240 215;

  --color-warning-100: 70 48 10;
  --color-warning-600: 230 180 80;
  --color-warning-700: 255 240 205;

  --color-danger-100: 80 30 25;
  --color-danger-600: 239 122 109;
  --color-danger-700: 255 230 226;

  --color-success-100: 20 56 36;
  --color-success-600: 111 207 151;
  --color-success-700: 215 240 224;

  --color-notification-100: 58 24 39;
  --color-notification-600: 245 165 191;

  --color-text-main: 233 239 233;
  --color-text-muted: 150 167 155;
  --color-text-contrast: 13 22 17;
  --color-text-alt2: 255 255 255;
  --color-text-code: 245 165 191;

  --color-hover-default: rgb(134 185 154 / 0.12);
  --color-marketing-logo: 134 185 154;
  --color-bw-blue: 134 185 154;

  --color-illustration-outline: 233 239 233;
  --color-illustration-bg-primary: 27 42 33;
  --color-illustration-bg-secondary: 46 64 53;
  --color-illustration-tertiary: 245 165 191;
  --color-illustration-logo: 134 185 154;
