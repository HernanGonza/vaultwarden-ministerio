/* ============================================================================
   Tema del Ministerio de Ecología y RNR de Misiones para Vaultwarden.
   Mismo lenguaje visual que la Wiki (Brandbook 2024): verdes institucionales,
   beige, rosa del lapacho, Oak Sans, botones en píldora y esquinas redondeadas.
   Se carga como "scss/user.vaultwarden.scss" (ver docker-compose.yml).
   Las variables RGB son tríos "R G B" (el front las usa con rgb(var(--x) / alpha)).
   ============================================================================ */

@font-face {
  font-family: "Oak Sans";
  src: url("../fonts/ministerio/OakSans-Variable.ttf") format("truetype");
  font-weight: 300 900;
  font-style: normal;
  font-display: swap;
}

/* ───────── Tema claro ───────── */
:root,
.theme_light {
  --color-shadow: 31 51 41;

  --color-background: 255 255 255;      /* tarjetas, paneles */
  --color-background-alt: 245 243 239;  /* fondo de página (beige) */
  --color-background-alt2: 62 108 81;   /* franjas de marca (verde) */
  --color-background-alt3: 31 51 41;    /* panel del menú */
  --color-background-alt4: 22 38 30;    /* ítem activo del menú */

  --color-primary-100: 230 235 224;
  --color-primary-300: 62 92 73;        /* hover de ítems del menú */
  --color-primary-600: 62 108 81;       /* links y botones */
  --color-primary-700: 47 84 62;        /* hover de links y botones */

  --color-secondary-100: 236 233 226;
  --color-secondary-300: 207 211 200;
  --color-secondary-500: 93 106 98;
  --color-secondary-600: 78 90 83;
  --color-secondary-700: 62 74 67;

  --color-info-100: 236 240 214;
  --color-info-600: 111 127 42;
  --color-info-700: 63 72 20;

  --color-warning-100: 253 243 214;
  --color-warning-600: 183 121 31;
  --color-warning-700: 122 76 10;

  --color-danger-100: 252 232 229;
  --color-danger-600: 192 57 43;
  --color-danger-700: 143 31 20;

  --color-success-100: 220 238 226;
  --color-success-600: 46 125 79;
  --color-success-700: 28 78 49;

  --color-notification-100: 251 227 234;
  --color-notification-600: 201 52 108;

  --color-text-main: 28 42 34;
  --color-text-muted: 93 106 98;
  --color-text-contrast: 255 255 255;
  --color-text-alt2: 255 255 255;
  --color-text-code: 201 52 108;

  --color-hover-default: rgb(62 108 81 / 0.1);
  --color-marketing-logo: 62 108 81;
  --color-bw-blue: 62 108 81;

  --color-illustration-outline: 31 51 41;
  --color-illustration-bg-primary: 230 235 224;
  --color-illustration-bg-secondary: 202 214 166;
  --color-illustration-tertiary: 201 52 108;
  --color-illustration-logo: 62 108 81;

  /* Paleta "brand" (la usan los componentes nuevos): verde institucional */
  --color-brand-050: #f0f5f1;
  --color-brand-100: #dfeae3;
  --color-brand-200: #c3d8cb;
  --color-brand-300: #9cbfaa;
  --color-brand-400: #6f9f84;
  --color-brand-500: #528566;
  --color-brand-600: #3e6c51;
  --color-brand-700: #325742;
  --color-brand-800: #284536;
  --color-brand-900: #1f3329;
  --color-brand-950: #0d1611;

  /* Grises: neutros verdosos de la Wiki. Todos los fondos, bordes y textos del front salen de esta escala. */
  --color-gray-050: #f5f3ef;
  --color-gray-100: #ece9e2;
  --color-gray-200: #dedad0;
  --color-gray-300: #cfd3c8;
  --color-gray-400: #96a79b;
  --color-gray-500: #6f7f75;
  --color-gray-600: #5d6a62;
  --color-gray-700: #2e4035;
  --color-gray-800: #1b2a21;
  --color-gray-900: #141f18;
  --color-gray-950: #0d1611;
  --color-gray-400-rgb: 150, 167, 155;
  --color-gray-700-rgb: 46, 64, 53;
  --color-gray-800-rgb: 27, 42, 33;
  --color-gray-950-rgb: 13, 22, 17;
  --color-brand-700-rgb: 50, 87, 66;
  --color-brand-800-rgb: 40, 69, 54;
  --color-brand-950-rgb: 13, 22, 17;

  /* Acento (en el original turquesa): rosa del Lapacho */
