  --color-teal-100: #fbe3ea;
  --color-teal-200: #f8c6d6;
  --color-teal-300: #f5a5bf;
  --color-teal-400: #e9709a;
  --color-teal-500: #d84c82;
  --color-teal-600: #c9346c;
  --color-teal-700: #a82a59;
  --color-teal-800: #8f1f4b;
  --color-teal-900: #6e1738;
  --color-teal-950: #3a0b1e;
}

